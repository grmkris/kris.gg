# The public site is static and reads no secrets at runtime. The variables below
# exist only for the private /stash inbox and /routes planner.

# Canonical origin, used for canonical URLs, Open Graph tags, the sitemap and
# robots (see src/lib/site.ts).
#
# On Vercel this is set per environment in the dashboard (not committed):
#   Production            NEXT_PUBLIC_SITE_URL=https://kris.gg
#   Preview (dev branch)  NEXT_PUBLIC_SITE_URL=https://dev.kris.gg
#
# Locally you can leave it unset — siteUrl() falls back to http://localhost:3001.
# NEXT_PUBLIC_SITE_URL=

# ── /stash ───────────────────────────────────────────────────────────────────
# Cloudflare D1, reached over its HTTP API (the site runs on Vercel, so no D1
# binding is available). Use SEPARATE databases per environment — pointing
# dev.kris.gg at the production database would write into the real stash.
#
#   Production   CLOUDFLARE_D1_DATABASE_ID=<kris-stash-prod id>
#   Preview/dev  CLOUDFLARE_D1_DATABASE_ID=<kris-stash-dev id>
#
# The API token needs the "D1 Edit" permission.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=

# Signing key for better-auth sessions/cookies. Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Machine capture surfaces (scripts/stash.ts, Raycast, MCP). Mint the key with
# better-auth's apiKey plugin once you are signed in.
#   STASH_URL defaults to the local dev server.
# STASH_API_KEY=
# STASH_URL=

# Gate for enrolling a passkey (see resolveOwner in src/lib/auth.ts). Registering
# binds the passkey to the single existing account, or creates it if there is
# none — so this secret is what stands between a public /stash URL and anyone
# enrolling their own device.
#
# It travels as a query parameter, so it lands in access logs: rotate it after
# enrolling devices, or unset it to close registration entirely. Generate with:
#   openssl rand -base64 24
STASH_REGISTRATION_SECRET=

# ── /routes ──────────────────────────────────────────────────────────────────
# OpenRouteService — routing, round-trip loop generation, elevation.
#
# NOTE: api.openrouteservice.org is retired on 2026-08-24. This code targets the
# replacement host, https://api.heigit.org/openrouteservice/v2. Register at
# https://account.heigit.org — tokens issued there are JWTs, so this value is
# long. Free tier: 2000 directions/day, 40/min.
ORS_API_KEY=

# Gemini, used to turn form input into routing constraints and to explain the
# generated route. Also used by the offline photo pipeline (scripts/photos/*).
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional pin for the Gemini model id; falls back to a probed default.
# GEMINI_MODEL=
