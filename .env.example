# The public site is static and reads no secrets at runtime. The variables below
# exist only for the private /stash inbox.

# Canonical origin, used for canonical URLs, Open Graph tags, the sitemap and
# robots (see src/lib/site.ts).
#
# On Vercel this is set per environment in the dashboard (not committed):
#   Production            NEXT_PUBLIC_SITE_URL=https://kris.gg
#   Preview (dev branch)  NEXT_PUBLIC_SITE_URL=https://dev.kris.gg
#
# Locally you can leave it unset — siteUrl() falls back to http://localhost:3001.
# NEXT_PUBLIC_SITE_URL=

# ── /stash ───────────────────────────────────────────────────────────────────
# Cloudflare D1, reached over its HTTP API (the site runs on Vercel, so no D1
# binding is available). Use SEPARATE databases per environment — pointing
# dev.kris.gg at the production database would write into the real stash.
#
#   Production   CLOUDFLARE_D1_DATABASE_ID=<kris-stash-prod id>
#   Preview/dev  CLOUDFLARE_D1_DATABASE_ID=<kris-stash-dev id>
#
# The API token needs the "D1 Edit" permission.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=

# Signing key for better-auth sessions/cookies. Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
